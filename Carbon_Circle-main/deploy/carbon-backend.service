[Unit]
Description=Carbon Backend API (清华绿创赛方案 B)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/green-creative-app/backend
Environment="PATH=/home/ubuntu/green-creative-app/backend/.venv/bin"
EnvironmentFile=/home/ubuntu/green-creative-app/backend/.env
ExecStart=/home/ubuntu/green-creative-app/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# 资源限制
LimitNOFILE=65536
MemoryMax=1G

[Install]
WantedBy=multi-user.target
